{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/neocjmix/figma-semantic-bridge/fixtures/manifest.schema.json",
  "title": "Figma Semantic Bridge fixture registry v1",
  "description": "Metadata-only evidence registry. Public visibility is not a license; candidate claims are not node measurements. All metric values require scope and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpus",
    "evaluatedAt",
    "artifactPolicy",
    "fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "corpus": {
      "enum": [
        "public",
        "synthetic"
      ]
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadataOnly": {
          "const": true
        },
        "sourceDataCommitted": {
          "const": false
        },
        "screenshotsCommitted": {
          "const": false
        }
      },
      "required": [
        "metadataOnly",
        "sourceDataCommitted",
        "screenshotsCommitted"
      ]
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/fixture"
      }
    }
  },
  "definitions": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "community",
                "figma-design"
              ]
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://(www\\.)?figma\\.com/"
            },
            "fileKey": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "communityResourceId": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]+$"
            },
            "revision": {
              "$ref": "#/definitions/revision"
            }
          },
          "required": [
            "kind",
            "url",
            "fileKey",
            "communityResourceId",
            "revision"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "community"
                  }
                }
              },
              "then": {
                "properties": {
                  "url": {
                    "pattern": "/community/file/[0-9]+",
                    "type": "string"
                  },
                  "communityResourceId": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "figma-design"
                  }
                }
              },
              "then": {
                "properties": {
                  "url": {
                    "pattern": "/(design|file)/[A-Za-z0-9]+",
                    "type": "string"
                  },
                  "fileKey": {
                    "type": "string",
                    "pattern": "^(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]+$"
                  },
                  "communityResourceId": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "observed",
                "reported",
                "unknown",
                "synthetic-project-fixture"
              ]
            },
            "identifier": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/evidence"
              }
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rawRedistributionApproved": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "identifier",
            "evidence",
            "conditions",
            "rawRedistributionApproved"
          ]
        },
        "duplication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permission": {
              "enum": [
                "offered-by-source",
                "unknown",
                "synthetic-baseline"
              ]
            },
            "attemptStatus": {
              "enum": [
                "not attempted",
                "succeeded",
                "failed"
              ]
            },
            "copyFileKey": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "permission",
            "attemptStatus",
            "copyFileKey",
            "notes"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "attemptStatus": {
                    "const": "succeeded"
                  }
                }
              },
              "then": {
                "properties": {
                  "copyFileKey": {
                    "type": "string",
                    "pattern": "^(?=[A-Za-z0-9]*[A-Za-z])[A-Za-z0-9]+$"
                  }
                }
              }
            }
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "candidate",
                "limited-use",
                "validated"
              ]
            },
            "structureVerified": {
              "type": "boolean"
            },
            "visualReview": {
              "enum": [
                "not performed",
                "performed"
              ]
            },
            "verifiedScopes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/scope"
              }
            },
            "unverified": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "structureVerified",
            "visualReview",
            "verifiedScopes",
            "unverified"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "candidate"
                  }
                }
              },
              "then": {
                "properties": {
                  "structureVerified": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "validated"
                  }
                }
              },
              "then": {
                "properties": {
                  "structureVerified": {
                    "const": true
                  },
                  "verifiedScopes": {
                    "minItems": 1,
                    "type": "array"
                  },
                  "visualReview": {
                    "const": "performed"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "structureVerified": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "verifiedScopes": {
                    "type": "array",
                    "contains": {
                      "type": "object",
                      "properties": {
                        "method": {
                          "const": "bounded-plugin-analysis"
                        },
                        "complete": {
                          "const": true
                        },
                        "report": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "method",
                        "complete",
                        "report"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        "structuralEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence"
          }
        },
        "qualitative": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/qualitative"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "totalNodeCount": {
              "$ref": "#/definitions/metric"
            },
            "pageNodeCounts": {
              "$ref": "#/definitions/metric"
            },
            "nodeTypeDistribution": {
              "$ref": "#/definitions/metric"
            },
            "maximumTreeDepth": {
              "$ref": "#/definitions/metric"
            },
            "averageTreeDepth": {
              "$ref": "#/definitions/metric"
            },
            "containerTypeRatios": {
              "$ref": "#/definitions/metric"
            },
            "autoLayoutRatio": {
              "$ref": "#/definitions/metric"
            },
            "textNodeCount": {
              "$ref": "#/definitions/metric"
            },
            "textNodeDensity": {
              "$ref": "#/definitions/metric"
            },
            "identicalBBoxRatio": {
              "$ref": "#/definitions/metric"
            },
            "nearIdenticalBBoxRatio": {
              "$ref": "#/definitions/metric"
            },
            "spatialOverlap": {
              "$ref": "#/definitions/metric"
            },
            "spatialContainment": {
              "$ref": "#/definitions/metric"
            },
            "treeContainmentMismatch": {
              "$ref": "#/definitions/metric"
            },
            "selectionExtractionMs": {
              "$ref": "#/definitions/metric"
            },
            "memoryBytes": {
              "$ref": "#/definitions/metric"
            },
            "networkTransferBytes": {
              "$ref": "#/definitions/metric"
            }
          },
          "required": [
            "totalNodeCount",
            "pageNodeCounts",
            "nodeTypeDistribution",
            "maximumTreeDepth",
            "averageTreeDepth",
            "containerTypeRatios",
            "autoLayoutRatio",
            "textNodeCount",
            "textNodeDensity",
            "identicalBBoxRatio",
            "nearIdenticalBBoxRatio",
            "spatialOverlap",
            "spatialContainment",
            "treeContainmentMismatch",
            "selectionExtractionMs",
            "memoryBytes",
            "networkTransferBytes"
          ]
        },
        "testPurposes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessConstraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysisResults": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "author",
        "source",
        "license",
        "duplication",
        "verification",
        "structuralEvidence",
        "qualitative",
        "metrics",
        "testPurposes",
        "accessConstraints",
        "analysisResults"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "validated"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "license": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "const": "observed"
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 1
                      }
                    }
                  },
                  "duplication": {
                    "type": "object",
                    "properties": {
                      "permission": {
                        "const": "offered-by-source"
                      },
                      "attemptStatus": {
                        "const": "succeeded"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "license": {
                    "type": "object",
                    "properties": {
                      "status": {
                        "const": "synthetic-project-fixture"
                      }
                    }
                  },
                  "duplication": {
                    "type": "object",
                    "properties": {
                      "permission": {
                        "const": "synthetic-baseline"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "observed",
            "source-claim",
            "llm-interpretation",
            "prior-report"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "checkedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        }
      },
      "required": [
        "kind",
        "statement",
        "source",
        "checkedAt"
      ]
    },
    "metric": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "not measured"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "measured"
            },
            "value": {
              "type": [
                "number",
                "object",
                "array"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "value",
            "unit",
            "scope",
            "method",
            "evidence"
          ]
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "method": {
          "enum": [
            "page-inventory",
            "node-inventory",
            "bounded-plugin-analysis",
            "image-review"
          ]
        },
        "checkedAt": {
          "type": "string",
          "anyOf": [
            {
              "format": "date-time"
            },
            {
              "format": "date"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pageId",
        "nodeIds",
        "method",
        "checkedAt",
        "complete",
        "report"
      ],
      "description": "Complete only describes the stated method and selected nodes, never the whole file."
    },
    "qualitative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "ui-spec-mix",
            "semantic-boundary-ambiguity",
            "visual-tree-mismatch",
            "spec-ui-linking-difficulty",
            "frontend-realism"
          ]
        },
        "status": {
          "enum": [
            "not assessed",
            "assessed"
          ]
        },
        "observedFacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "llmInterpretation": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "dimension",
        "status",
        "observedFacts",
        "llmInterpretation",
        "limitations"
      ]
    },
    "revision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "known"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "value"
          ]
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "corpus": {
            "const": "public"
          }
        }
      },
      "then": {
        "properties": {
          "fixtures": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "license": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "observed",
                        "reported",
                        "unknown"
                      ]
                    }
                  }
                },
                "duplication": {
                  "type": "object",
                  "properties": {
                    "permission": {
                      "enum": [
                        "offered-by-source",
                        "unknown"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
